# Public frontend configuration only.
# Never place Appwrite API keys, admin secrets, or private tokens in Angular env files.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=replace-with-appwrite-project-id
APPWRITE_DATABASE_ID=college-management

APPWRITE_BUCKET_MEDIA=media
APPWRITE_BUCKET_AVATARS=avatars
APPWRITE_BUCKET_DOCUMENTS=documents

APPWRITE_TABLE_USERS=users
APPWRITE_TABLE_ROLES=roles
APPWRITE_TABLE_PERMISSIONS=permissions
APPWRITE_TABLE_STUDENTS=students
APPWRITE_TABLE_FACULTY=faculty
APPWRITE_TABLE_DEPARTMENTS=departments
APPWRITE_TABLE_COURSE_OFFERINGS=course_offerings
APPWRITE_TABLE_ATTENDANCE_SESSIONS=attendance_sessions
APPWRITE_TABLE_ATTENDANCE_RECORDS=attendance_records
APPWRITE_TABLE_BOOKS=books
APPWRITE_TABLE_BOOK_ISSUES=book_issues
APPWRITE_TABLE_RESULTS=results
APPWRITE_TABLE_NOTIFICATIONS=notifications
APPWRITE_TABLE_ACTIVITY=activity
